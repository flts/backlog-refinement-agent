{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.backlog-refinement-agent.dev/schemas/suggest-next-actions.args.schema.json",
  "title": "suggest_next_actions arguments",
  "description": "Arguments of the agent-service tool `suggest_next_actions`: offer at most 3 short follow-up actions as chips. The server mirrors them into state.nextActions.",
  "x-tool": "suggest_next_actions",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id of the chip."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Chip text shown to the user (at most 60 characters)."
          },
          "intent": {
            "type": "string",
            "enum": [
              "refine",
              "continue",
              "breakdown",
              "assess",
              "message"
            ],
            "description": "What the chip does: start a run with that intent, or send `prompt` as a normal message."
          },
          "prompt": {
            "type": "string",
            "description": "Message sent when intent is message, or additional instruction for the run."
          }
        },
        "required": [
          "id",
          "label",
          "intent"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "message"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 3,
      "description": "At most 3 chips."
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}
