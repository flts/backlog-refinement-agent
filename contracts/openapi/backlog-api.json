                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Display name once the member has signed in; otherwise null."
          },
          "signedIn": {
            "type": "boolean",
            "title": "Signedin",
            "description": "Whether this email address has signed in at least once."
          },
          "addedBy": {
            "type": "string",
            "title": "Addedby"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Addedat"
          }
        },
        "type": "object",
        "required": [
          "email",
          "role",
          "name",
          "signedIn",
          "addedBy",
          "addedAt"
        ],
        "title": "MemberOut"
      },
      "MemberUpdate": {
        "properties": {
