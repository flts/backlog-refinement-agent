  "components": {
    "schemas": {
      "Me": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "sub"
        ],
        "title": "Me"
      },
      "MemberAdd": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 318,
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "contributor"
            ],
            "title": "Role",
            "default": "contributor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "MemberAdd"
      },
      "MemberList": {
        "properties": {
          "items": {
