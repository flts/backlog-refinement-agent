# Copy to .env.local and set values for your OpenAI-compatible proxy.
VITE_LLM_ENDPOINT=https://your-proxy.example/v1/chat/completions
VITE_LLM_MODEL=your-model
# Optional: enable OpenAI-compatible SSE response streaming (true or false; defaults to false).
VITE_LLM_STREAMING=false
# Read only by the local Vite development server; production builds always omit this key.
LOCAL_LLM_API_KEY=replace-with-your-local-development-key
