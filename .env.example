# Docker Compose settings. Copy to `.env` (git-ignored): cp .env.example .env
# Everything below has a working DEV-ONLY default, so `docker compose --profile fake up --build` works without a .env.
# NEVER reuse these dev defaults outside a local machine.

# --- LLM gateway (OpenAI-compatible, base URL without /v1 is fine) ---------------------------------------------
# Default: the bundled scripted fake gateway (start it with `--profile fake`). For a real gateway set the URL and key
# and start without the fake profile.
LLM_BASE_URL=http://fake-gateway:8090
LLM_API_KEY=dev-fake-key
# Chat/reasoning model (agent-service) and embedding model + vector dimension (backlog-api; must match the model).
LLM_MODEL=reasoning-large
EMBEDDING_MODEL=text-embedding
EMBEDDING_DIM=1536

# --- Application environment ---------------------------------------------------------------------------------
# production (default): migrations still run on start, dev shortcuts (X-Dev-User-Email, static internal token,
# plain-HTTP URL fetch) are refused. Use `development` only to experiment.
APP_ENV=production

# --- Secrets (DEV-ONLY defaults) -------------------------------------------------------------------------------
POSTGRES_PASSWORD=dev-postgres-password
BACKLOG_DB_PASSWORD=dev-backlog-db-password
AGENT_DB_PASSWORD=dev-agent-db-password
# Must match the `agent-service` client secret in deploy/keycloak/realms/backlog-realm.json (dev-agent-service-secret).
AGENT_SERVICE_CLIENT_SECRET=dev-agent-service-secret
# Shared by all backlog-api replicas; signs the short-lived SSE stream tickets.
BACKLOG_EVENTS_TICKET_SECRET=dev-events-ticket-secret-change-me
# Keycloak bootstrap admin (http://localhost:8080/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-admin-password
