# Copy to .env.local. Read only by the local Vite dev server, which serves them as /config.json.
# Nothing here is bundled into builds; production serves /config.json from runtime configuration.
# Base URL only; the app appends /v1/chat/completions and /v1/models.
LLM_ENDPOINT=https://your-proxy.example
# Optional default model; when empty, pick one from /v1/models or type it in Settings.
LLM_MODEL=
# Optional: enable OpenAI-compatible SSE response streaming (true or false; defaults to false).
LLM_STREAMING=false
LOCAL_LLM_API_KEY=replace-with-your-local-development-key
