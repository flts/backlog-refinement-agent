{
  "name": "backlog-refinement-agent",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --dir apphost start",
    "dev:web": "pnpm --filter @backlog/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test:py": "uv run --all-packages pytest services libs",
    "lint:py": "uv run --all-packages ruff check services libs"
  }
}
