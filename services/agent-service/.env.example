# agent-service local development settings. Copy to services/agent-service/.env (git-ignored).
# Under Aspire (`aspire run`) these are injected automatically:
#   ConnectionStrings__agentdb=Host=...;Port=...;Username=...;Password=...;Database=agentdb
#   services__keycloak__http__0=http://localhost:8080
#   services__backlog-api__http__0=http://localhost:8001

AGENT_ENV=development
AGENT_LOG_LEVEL=INFO

# Database (URI or ADO.NET key-value string; converted to postgresql+asyncpg).
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5432/agentdb
# Run alembic migrations on startup (defaults to true when AGENT_ENV=development).
# AGENT_AUTO_MIGRATE=true

# Authentication: jwt (default) validates Keycloak access tokens (audience agent-service).
AGENT_AUTH_MODE=jwt
AGENT_OIDC_ISSUER=http://localhost:8080/realms/backlog
AGENT_OIDC_AUDIENCE=agent-service
# AGENT_OIDC_JWKS_URL=http://localhost:8080/realms/backlog/protocol/openid-connect/certs
# Dev-only shortcut without Keycloak: trusts the X-Dev-User-Email header (refused unless AGENT_ENV=development).
# AGENT_AUTH_MODE=dev

# backlog-api (thread access checks and, later, the MCP connection), called with the user's own token.
AGENT_BACKLOG_API_URL=http://localhost:8001

# Agent definitions (agents/*.agent.md), MCP server bindings and default skills (defaults: the package directories).
# In AGENT_ENV=development changes to these files are picked up without a restart.
# AGENT_AGENTS_DIR=services/agent-service/agents
# AGENT_TOOLS_FILE=services/agent-service/tools/tools.yaml
# AGENT_SKILLS_DIR=skills
# Version shown in the agent catalogue (default: git short sha, else "dev").
# AGENT_BUILD_SHA=

# LLM gateway (OpenAI-compatible). The base URL gets /v1 appended when missing.
AGENT_LLM_BASE_URL=http://localhost:8090
# chat = /v1/chat/completions (default), responses = /v1/responses
# AGENT_LLM_API=chat
AGENT_LLM_MODEL=refiner-default
# AGENT_LLM_API_KEY=
# Make /readyz fail while the gateway is unreachable (default: only reported as "llm": "unavailable").
# AGENT_LLM_REQUIRED_FOR_READINESS=false

# Limits and CORS (default: same-origin through the dev proxy, no CORS).
# AGENT_MAX_BODY_BYTES=1048576
# AGENT_AGUI_MAX_BODY_BYTES=2097152
# AGENT_CORS_ALLOW_ORIGINS=http://localhost:5173

# Event hooks (purge private threads when backlog-api deletes projects/items or removes members).
# AGENT_EVENT_HOOKS_ENABLED=true
# Keycloak client credentials (dev realm secret; replace elsewhere):
# AGENT_SERVICE_CLIENT_ID=agent-service
# AGENT_SERVICE_CLIENT_SECRET=dev-agent-service-secret
# Development-only alternative, must match BACKLOG_INTERNAL_TOKEN of backlog-api:
# AGENT_INTERNAL_TOKEN=
