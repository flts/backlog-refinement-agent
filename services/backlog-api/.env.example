# backlog-api local development settings. Copy to services/backlog-api/.env (git-ignored).
# Under Aspire (`aspire run`) the database and Keycloak references are injected automatically:
#   ConnectionStrings__backlogdb=Host=...;Port=...;Username=...;Password=...;Database=backlogdb
#   services__keycloak__http__0=http://localhost:8080
# and BACKLOG_DATABASE_URL / BACKLOG_OIDC_ISSUER are then not needed.

BACKLOG_ENV=development
BACKLOG_LOG_LEVEL=INFO

# Database (URI or ADO.NET key-value string; converted to postgresql+asyncpg).
BACKLOG_DATABASE_URL=postgresql://backlog:backlog@localhost:5432/backlogdb
# Run alembic migrations on startup (defaults to true when BACKLOG_ENV=development).
# BACKLOG_AUTO_MIGRATE=true

# Authentication: jwt (default) validates Keycloak access tokens.
BACKLOG_AUTH_MODE=jwt
BACKLOG_OIDC_ISSUER=http://localhost:8080/realms/backlog
BACKLOG_OIDC_AUDIENCE=backlog-api
# Optional: skip discovery and use this JWKS URL directly.
# BACKLOG_OIDC_JWKS_URL=http://localhost:8080/realms/backlog/protocol/openid-connect/certs
# Alternatively give only the Keycloak base URL; the issuer becomes <url>/realms/<realm>.
# BACKLOG_KEYCLOAK_URL=http://localhost:8080
# BACKLOG_OIDC_REALM=backlog

# Dev-only shortcut without Keycloak: trusts the X-Dev-User-Email header.
# Refused at startup unless BACKLOG_ENV=development.
# BACKLOG_AUTH_MODE=dev

# Maximum request body size in bytes (default 1 MiB).
# BACKLOG_MAX_BODY_BYTES=1048576

# OpenTelemetry (Aspire injects these); telemetry is off without an endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Events (SSE): tickets need a secret shared by all replicas (a random per-process one is used outside production).
# BACKLOG_EVENTS_TICKET_SECRET=change-me
# Internal stream for agent-service: allowed Keycloak client ids, or (development only) a static shared secret.
# BACKLOG_INTERNAL_CLIENT_IDS=agent-service
# BACKLOG_INTERNAL_TOKEN=dev-internal-token
