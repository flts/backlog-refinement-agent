# Copy to .env.local. Read only by the local Vite dev server, which serves them as /config.json
# and uses the service URLs for the dev proxy. Nothing here is bundled into builds; production serves
# /config.json from container environment variables (see deploy/caddy/Caddyfile).

# oidc: the SPA signs in with Authorization Code + PKCE (Keycloak realm `backlog`, users alice/bob/carol@example.test,
#       password dev-password). platform: the gateway authenticates; the SPA only calls /api/backlog/me.
AUTH_MODE=oidc
OIDC_AUTHORITY=http://localhost:8080/realms/backlog
OIDC_CLIENT_ID=backlog-web
OIDC_SCOPE=openid profile email
AGENT_ID=backlog-refiner

# Dev proxy targets for /api/backlog and /api/agent (the Aspire AppHost sets both). Aspire's
# services__backlog-api__http__0 and services__agent-service__http__0 are honoured when these are unset.
# PORT, when set, is used as the dev server port. AGENT_SERVICE_URL is accepted as an alias of AGENT_API_URL.
BACKLOG_API_URL=http://localhost:8001
AGENT_API_URL=http://localhost:8002
